<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RefFriendlyQuests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.1.1</Version>
    <DebugType>None</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <SPTPath Condition="'$(SPTPath)' == ''">C:\sptarkov\SPTarkov 5.0.0-BE-1.3.0.0.48484</SPTPath>
    <ModOutputDir>$(MSBuildProjectDirectory)/Build/SPT_Runtime/user/mods/acidphantasm-reffriendlyquests</ModOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SPTarkov.Common;SPTarkov.DI;SPTarkov.Server.Core;SPTarkov.Server.Web;SemanticVersioning">
      <HintPath>$(SPTPath)/SPT_Runtime/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**;Build/**;bin/**;obj/**" />
  </ItemGroup>
  <Target Name="ValidateReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SPTPath)/SPT_Runtime/SPTarkov.Server.Core.dll')" Text="Set SPTPath to the matching SPT 5.0 game installation." />
  </Target>
  <Target Name="StageMod" AfterTargets="Build">
    <ItemGroup>
      <ModFiles Include="$(TargetPath);$(MSBuildProjectDirectory)/LICENSE;$(MSBuildProjectDirectory)/config.json;$(MSBuildProjectDirectory)/README.md" />
      <ModData Include="$(MSBuildProjectDirectory)/db/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModOutputDir)" />
    <Copy SourceFiles="@(ModData)" DestinationFolder="$(ModOutputDir)/db/%(RecursiveDir)" />
  </Target>
</Project>
